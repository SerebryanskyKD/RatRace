# ====================================
# Unreal Engine Ignore Rules
# ====================================

# Папки сборки и бинарных файлов (они создаются заново компиляцией)
Binaries/*
Plugins/*/Binaries/*

# Кэш шейдеров и данных движка
DerivedDataCache/*

# Промежуточные файлы компиляции
Intermediate/*
Plugins/*/Intermediate/*

# Автосохранения, логи, крэш-дампы
Saved/*

# Локальные сборки и релизные пакеты
Build/*

# ====================================
# Visual Studio / IDE / Редакторы кода
# ====================================

.vs/
.idea/
.vscode/

# Сгенерированные файлы решений Visual Studio
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Сгенерированные файлы проектов
*.vcxproj
*.vcxproj.filters

# Скрипты Xcode (если кто-то сидит на macOS)
*.xcodeproj
*.xcworkspace

# ====================================
# Системные файлы ОС
# ====================================
.DS_Store
Thumbs.db
desktop.ini